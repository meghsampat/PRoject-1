{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FMCG: Local dashboard in VS Code",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_local.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "FMCG: Check local setup",
      "serverReadyAction": {
        "pattern": "URL: (http://127\\.0\\.0\\.1:[0-9]+)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser",
        "killOnServerStop": true
      }
    },
    {
      "name": "FMCG: Preview running dashboard",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://127.0.0.1:8501",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
